{
  "name": "dsh-mobile-ui",
  "version": "0.1.1",
  "private": true,
  "description": "Phone-first layout for the DeepSeek Harness web UI: off-canvas sidebar, top bar, and iOS keyboard fixes",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
